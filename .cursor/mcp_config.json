{
  "mcpServers": {
    "n8n": {
      "command": "n8n-mcp",
      "args": [],
      "env": {
        "NODE_ENV": "production",
        "N8N_API_URL": "http://localhost:5678/api",
        "N8N_API_KEY": "${N8N_API_KEY}"
      }
    },
    "canva": {
      "command": "npx",
      "args": [
        "-y",
        "@canva/cli@latest",
        "mcp"
      ]
    }
  }
}